diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index 05efb3a..3ef0396 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -120,6 +120,9 @@ struct rtlsdr_dev {
 	/* scanner-v5: tuner I2C transfers retried / failed after all retries */
 	uint32_t i2c_retries;
