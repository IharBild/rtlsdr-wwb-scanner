 int rtlsdr_i2c_read_fn(void *dev, uint8_t addr, uint8_t *buf, int len);
+/* scanner-v6: retried tuner I2C transfers so far (the tuner driver compares
+ * it before and after a transfer), and 1 once the USB device is gone */
+uint32_t rtlsdr_i2c_retry_count(void *dev);
+int rtlsdr_i2c_device_gone(void *dev);
 
 #endif
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
index 08a72d8..337c119 100644
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -92,6 +92,12 @@ struct r82xx_priv {
 	/* scanner-v4: PLL statistics since open */
 	uint32_t			pll_late_locks;	/* locked only after extra wait */
 	uint32_t			pll_unlocks;	/* gave up, PLL not locked */
