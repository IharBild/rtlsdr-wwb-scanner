From 5049ecd543ac2a4c6f86bffed7ba99598eee5ef7 Mon Sep 17 00:00:00 2001
From: rtlsdr-wwb-scanner <noreply@example.invalid>
Date: Fri, 13 Nov 2026 19:00:00 +0100
Subject: [PATCH] scanner-v7: rtlsdr_set_dithering() and the GPIO API for
 pyrtlsdr >= 0.4

pyrtlsdr 0.4 and later (0.5.1 supports Python 3.10+) bind these functions
of the librtlsdr fork when they are imported and call
rtlsdr_set_dithering(dev, 1) in open(); without them the import fails.

- rtlsdr_set_dithering(): R820T/R828D PLL dithering, bit 4 of tuner
  register 0x12 as in the fork; on by default (register values unchanged,
  the power-on value 0x80 has the bit 0), 0 turns it off at the next
  retune; other tuners return 1 (nothing to do).
- rtlsdr_set_gpio_output / _input / _bit, rtlsdr_get_gpio_bit,
  rtlsdr_set_gpio_byte, rtlsdr_get_gpio_byte, rtlsdr_set_gpio_status:
  same names, arguments and register use as in the fork; they return 0 or
  -1. set_gpio_bit and set_gpio_output already existed inside the driver
  (void): the register sequence is the same, except that set_gpio_output
  stops at the first failed write (as the fork). USB model: all scanner-v6
  scenarios give the same results; closing an unplugged dongle makes 3 USB
  transfers instead of 5.
---
 include/rtl-sdr.h     | 25 ++++++++++++
 include/tuner_r82xx.h |  1 +
 src/librtlsdr.c       | 88 +++++++++++++++++++++++++++++++++++++++----
 src/tuner_r82xx.c     |  3 ++
 4 files changed, 110 insertions(+), 7 deletions(-)

diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
index a7633f7..7ec96f6 100644
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -466,6 +466,31 @@ RTLSDR_API int rtlsdr_get_tuner_restores(rtlsdr_dev_t *dev, uint32_t *restores);
  */
 RTLSDR_API int rtlsdr_set_sync_read_timeout(rtlsdr_dev_t *dev, int timeout_ms);
 
+/*!
+ * scanner-v7: PLL dithering of the R820T/R828D tuner, on by default.
+ * Same name and meaning as in the librtlsdr fork (needed by pyrtlsdr >= 0.4).
+ *
+ * \param dev the device handle given by rtlsdr_open()
+ * \param dither 1 on (default), 0 off; used at the next retune
+ * \return 0 on success, 1 not applicable to this tuner, -1 no device
+ */
+RTLSDR_API int rtlsdr_set_dithering(rtlsdr_dev_t *dev, int dither);
+
+/*!
+ * scanner-v7: GPIO pins 0..7 of the RTL2832U, the API of the librtlsdr fork
+ * (needed by pyrtlsdr >= 0.4). Careful: pin 0 drives the bias tee (power on
+ * the antenna input, rtlsdr_set_bias_tee()).
+ *
+ * \return 0 on success, -1 on error
+ */
+RTLSDR_API int rtlsdr_set_gpio_output(rtlsdr_dev_t *dev, uint8_t gpio);
+RTLSDR_API int rtlsdr_set_gpio_input(rtlsdr_dev_t *dev, uint8_t gpio);
+RTLSDR_API int rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val);
+RTLSDR_API int rtlsdr_get_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int *val);
+RTLSDR_API int rtlsdr_set_gpio_byte(rtlsdr_dev_t *dev, int val);
+RTLSDR_API int rtlsdr_get_gpio_byte(rtlsdr_dev_t *dev, int *val);
+RTLSDR_API int rtlsdr_set_gpio_status(rtlsdr_dev_t *dev, int *status);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
index 337c119..1ab31e6 100644
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -98,6 +98,7 @@ struct r82xx_priv {
 	int				restoring;	/* inside r82xx_restore() */
 	int				pll_written;	/* PLL programmed since init */
 	int				gone_reported;	/* "device gone" already printed */
+	int				disable_dither;	/* scanner-v7: rtlsdr_set_dithering(dev, 0) */
 
 	/* Store current mode */
 	uint32_t			delsys;
diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index fb99acc..56204a3 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -135,7 +135,7 @@ struct rtlsdr_dev {
 	enum rtlsdr_ds_mode direct_sampling_mode;
 };
 
-void rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val);
+int rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val);
 static int rtlsdr_set_if_freq(rtlsdr_dev_t *dev, uint32_t freq);
 
 /* generic tuner interface functions, shall be moved to the tuner implementations */
@@ -569,25 +569,84 @@ int rtlsdr_demod_write_reg(rtlsdr_dev_t *dev, uint8_t page, uint16_t addr, uint1
 	return (r == len) ? 0 : -1;
 }
 
-void rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val)
+/* scanner-v7: rtlsdr_set_gpio_bit() and rtlsdr_set_gpio_output() are public
+ * now (the API of the librtlsdr fork that pyrtlsdr >= 0.4 binds), returning
+ * 0 or -1 (the write result); the register sequence is the same as before. */
+int rtlsdr_set_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int val)
 {
 	uint16_t r;
 
+	if (!dev || gpio > 7)
+		return -1;
 	gpio = 1 << gpio;
 	r = rtlsdr_read_reg(dev, SYSB, GPO, 1);
 	r = val ? (r | gpio) : (r & ~gpio);
-	rtlsdr_write_reg(dev, SYSB, GPO, r, 1);
+	return rtlsdr_write_reg(dev, SYSB, GPO, r, 1) < 0 ? -1 : 0;
 }
 
-void rtlsdr_set_gpio_output(rtlsdr_dev_t *dev, uint8_t gpio)
+int rtlsdr_set_gpio_output(rtlsdr_dev_t *dev, uint8_t gpio)
 {
 	int r;
+
+	if (!dev || gpio > 7)
+		return -1;
 	gpio = 1 << gpio;
+	r = rtlsdr_read_reg(dev, SYSB, GPD, 1);
+	if (rtlsdr_write_reg(dev, SYSB, GPD, r & ~gpio, 1) < 0)
+		return -1;
+	r = rtlsdr_read_reg(dev, SYSB, GPOE, 1);
+	return rtlsdr_write_reg(dev, SYSB, GPOE, r | gpio, 1) < 0 ? -1 : 0;
+}
 
+/* scanner-v7: the rest of that GPIO API (semantics as in the librtlsdr fork:
+ * GPD bit 1 = input, GPOE bit 1 = output enabled; GPI = pin levels) */
+int rtlsdr_set_gpio_input(rtlsdr_dev_t *dev, uint8_t gpio)
+{
+	int r;
+
+	if (!dev || gpio > 7)
+		return -1;
+	gpio = 1 << gpio;
 	r = rtlsdr_read_reg(dev, SYSB, GPD, 1);
-	rtlsdr_write_reg(dev, SYSB, GPD, r & ~gpio, 1);
+	if (rtlsdr_write_reg(dev, SYSB, GPD, r | gpio, 1) < 0)
+		return -1;
 	r = rtlsdr_read_reg(dev, SYSB, GPOE, 1);
-	rtlsdr_write_reg(dev, SYSB, GPOE, r | gpio, 1);
+	return rtlsdr_write_reg(dev, SYSB, GPOE, r & ~gpio, 1) < 0 ? -1 : 0;
+}
+
+int rtlsdr_get_gpio_bit(rtlsdr_dev_t *dev, uint8_t gpio, int *val)
+{
+	uint16_t r;
+
+	if (!dev || !val || gpio > 7)
+		return -1;
+	r = rtlsdr_read_reg(dev, SYSB, GPI, 1);
+	*val = (r & (1 << gpio)) ? 1 : 0;
+	return 0;
+}
+
+int rtlsdr_set_gpio_byte(rtlsdr_dev_t *dev, int val)
+{
+	if (!dev)
+		return -1;
+	return rtlsdr_write_reg(dev, SYSB, GPO, val & 0xff, 1) < 0 ? -1 : 0;
+}
+
+int rtlsdr_get_gpio_byte(rtlsdr_dev_t *dev, int *val)
+{
+	if (!dev || !val)
+		return -1;
+	*val = rtlsdr_read_reg(dev, SYSB, GPI, 1) & 0xff;
+	return 0;
+}
+
+/* the name is the fork's: it READS the direction register (GPD) */
+int rtlsdr_set_gpio_status(rtlsdr_dev_t *dev, int *status)
+{
+	if (!dev || !status)
+		return -1;
+	*status = rtlsdr_read_reg(dev, SYSB, GPD, 1) & 0xff;
+	return 0;
 }
 
 void rtlsdr_set_i2c_repeater(rtlsdr_dev_t *dev, int on)
@@ -1518,7 +1577,7 @@ int rtlsdr_check_dongle_model(void *dev, char *manufact_check, char *product_che
 
 /* ---- scanner-v4 additions ---- */
 #ifndef RTLSDR_BUILD_INFO
-#define RTLSDR_BUILD_INFO "rtl-sdr-blog + scanner-v6 (unknown revision)"
+#define RTLSDR_BUILD_INFO "rtl-sdr-blog + scanner-v7 (unknown revision)"
 #endif
 
 int rtlsdr_get_tuner_pll_lock(rtlsdr_dev_t *dev, uint32_t *late_locks,
@@ -2263,6 +2322,21 @@ int rtlsdr_get_i2c_stats(rtlsdr_dev_t *dev, uint32_t *retries, uint32_t *failure
 	return 0;
 }
 
+/* scanner-v7: PLL dithering of the R820T/R828D (bit 4 of tuner register
+ * 0x12, as in the librtlsdr fork). On by default, as before; pyrtlsdr >= 0.4
+ * calls this with 1 when it opens the device, which changes nothing. Takes
+ * effect at the next retune. Other tuners: 1 (nothing to do), as the fork. */
+int rtlsdr_set_dithering(rtlsdr_dev_t *dev, int dither)
+{
+	if (!dev)
+		return -1;
+	if (dev->tuner_type == RTLSDR_TUNER_R820T || dev->tuner_type == RTLSDR_TUNER_R828D) {
+		dev->r82xx_p.disable_dither = dither ? 0 : 1;
+		return 0;
+	}
+	return 1;
+}
+
 int rtlsdr_get_tuner_restores(rtlsdr_dev_t *dev, uint32_t *restores)
 {
 	if (!dev)
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
index 6cd5bf6..0e8b1e7 100644
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -690,6 +690,9 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 		val = 0x00;
 
 	regs[2] = mask_reg8(regs[2], val, 0x08);
+	/* scanner-v7: dithering (bit 4) - 0 unless rtlsdr_set_dithering(dev, 0);
+	 * the power-on value of register 0x12 (0x80) has it 0 too */
+	regs[2] = mask_reg8(regs[2], priv->disable_dither ? 0x10 : 0x00, 0x10);
 
 	regs[5] = sdm & 0xff;
 	regs[6] = sdm >> 8;
-- 
2.43.0

