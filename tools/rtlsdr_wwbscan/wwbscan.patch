@@ -409,6 +409,32 @@
 
 RTLSDR_API int rtlsdr_check_dongle_model(void *dev, char *manufact_check, char *product_check);
 
+/* ---- wwbscan scan edition (rtlsdr-wwb-scanner) ---- */
+
+/*!
+ * Version string of the scan edition, e.g. "wwbscan-1".
+ */
+RTLSDR_API const char *rtlsdr_wwbscan_version(void);
+
+/*!
+ * Fast retune: skip tuner register writes whose value did not change and
+ * write the PLL registers in one I2C transfer. Off by default.
+ */
+RTLSDR_API int rtlsdr_set_fast_tune(rtlsdr_dev_t *dev, int on);
+RTLSDR_API int rtlsdr_get_fast_tune(rtlsdr_dev_t *dev);
+
+/*!
+ * PLL lock state after the last rtlsdr_set_center_freq().
+ * \return 1 locked, 0 not locked, -1 unknown (non-R82xx tuner or error)
+ */
+RTLSDR_API int rtlsdr_get_tuner_lock(rtlsdr_dev_t *dev);
+
+/*!
+ * Timeout for rtlsdr_read_sync() in milliseconds, 0 = wait forever
+ * (original behaviour). On timeout rtlsdr_read_sync() returns -7.
+ */
+RTLSDR_API int rtlsdr_set_read_timeout(rtlsdr_dev_t *dev, unsigned int timeout_ms);
+
 #ifdef __cplusplus
 }
 #endif
